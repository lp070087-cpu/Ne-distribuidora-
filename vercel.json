{
  "rewrites": [
    {
      "source": "/ofertas",
      "destination": "/ofertas.html"
    },
    {
      "source": "/estoque",
      "destination": "/estoque-inteligente-v3.html"
    },
    {
      "source": "/vendedor",
      "destination": "/painel-vendedores.html"
    },
    {
      "source": "/minha-conta",
      "destination": "/minha-conta.html"
    }
  ],
  "redirects": [
    {
      "source": "/distribuidora.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/loja-revendedores.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/minha-conta",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/minha-conta.html",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
